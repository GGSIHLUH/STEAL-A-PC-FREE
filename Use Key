local hScale = mk("UIScale", { Scale = 1 }, holder)
local userScale, zoom = 1, 1
local function fit()
	local cam = workspace.CurrentCamera
	if not cam then return end
	local vp = cam.ViewportSize
	local base = math.clamp(math.min(vp.X / (WW + 30), vp.Y / (WH + 30)), 0.4, 1.2)
	local maxS = math.max(0.4, math.min(vp.X / (WW + 8), vp.Y / (WH + 8)))
	hScale.Scale = math.clamp(base * userScale * zoom, 0.4, maxS)
end
