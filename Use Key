-- toggle (gaya Fluent)
local Ctl = { toggles = {}, handlers = {}, dropdowns = {}, sliders = {} }
local function toggleRow(page, name, desc)
	local f = row(page, name, desc)
	local pillF = mk("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(42, 22),
		BackgroundColor3 = th("ACCENT"), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 5 }, f)
	corner(pillF, 11)
	local ps = stroke(pillF, "SUB", 1.4, 0)
	local knob = mk("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.new(0, 4, 0.5, 0), Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = th("TEXT"), BorderSizePixel = 0, ZIndex = 6 }, pillF)
	corner(knob, 7)
	local state = false
	local obj = {}
	local function paint()
		tw(pillF, 0.15, { BackgroundTransparency = state and 0 or 1 })
		tw(knob, 0.15, { Position = state and UDim2.new(0, 24, 0.5, 0) or UDim2.new(0, 4, 0.5, 0) })
		knob.BackgroundColor3 = state and Color3.new(0, 0, 0) or T.TEXT
		ps.Transparency = state and 1 or 0
	end
	function obj.get() return state end
	function obj.set(s)
		s = not not s
		if s == state then return end
		state = s
		paint()
		local h = Ctl.handlers[name]
		if h then task.spawn(h, s) end
	end
	local hit = mk("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 7 }, f)
	hit.Activated:Connect(function() obj.set(not state) end)
	themeHooks[#themeHooks + 1] = paint
	Ctl.toggles[name] = obj
	return obj
end

-- dropdown (popup melayang seperti Fluent)
local popup, catcher
local function closePopup()
	if popup then popup:Destroy() popup = nil end
	if catcher then catcher:Destroy() catcher = nil end
end
local function openPopup(btn, options, selected, onPick)
	closePopup()
	local sc = hScale.Scale
	local rel = (btn.AbsolutePosition - win.AbsolutePosition) / sc
	local bsz = btn.AbsoluteSize / sc
	catcher = mk("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 29 }, win)
	catcher.Activated:Connect(closePopup)
	local count = math.max(#options, 1)
	local h = math.min(count, 6) * 30 + 8
	local y = rel.Y + bsz.Y + 4
	if y + h > WH - 6 then y = math.max(36, rel.Y - h - 4) end
	popup = mk("Frame", {
		Position = UDim2.fromOffset(rel.X, y), Size = UDim2.fromOffset(math.max(bsz.X, 150), h), BackgroundColor3 = Color3.fromRGB(28, 28, 32),
		BackgroundTransparency = 0.04, BorderSizePixel = 0, ZIndex = 30,
	}, win)
	corner(popup, 8)
	stroke(popup, "STROKE", 1, 0.3)
	local list = mk("ScrollingFrame", {
		Size = UDim2.new(1, -8, 1, -8), Position = UDim2.fromOffset(4, 4), BackgroundTransparency = 1, BorderSizePixel = 0,
		ScrollBarThickness = 3, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ZIndex = 31,
	}, popup)
	mk("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, list)
	if #options == 0 then
		mk("TextLabel", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, Text = "  (kosong)", TextColor3 = Color3.fromRGB(170, 170, 176),
			Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 32 }, list)
	end
	for i, opt in ipairs(options) do
		local b = mk("TextButton", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = Color3.new(1, 1, 1),
			BackgroundTransparency = (opt == selected) and 0.88 or 1, Text = "", AutoButtonColor = false, ZIndex = 32 }, list)
		corner(b, 6)
		mk("TextLabel", { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -20, 1, 0), BackgroundTransparency = 1, Text = tostring(opt),
			TextColor3 = Color3.new(1, 1, 1), Font = Enum.Font.GothamMedium, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left,
			TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 33 }, b)
		b.MouseEnter:Connect(function() if opt ~= selected then b.BackgroundTransparency = 0.94 end end)
		b.MouseLeave:Connect(function() if opt ~= selected then b.BackgroundTransparency = 1 end end)
		b.Activated:Connect(function()
			closePopup()
			onPick(opt)
		end)
	end
end

