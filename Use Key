local function sliderRow(page, name, desc, min, max, step, default, onChange)
	local f = row(page, name, desc)
	local vl = text(f, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -12, 0.5, 0), Size = UDim2.fromOffset(46, 20),
		TextXAlignment = Enum.TextXAlignment.Right, TextSize = 12, TextColor3 = th("SUB"), ZIndex = 5 })
	local hit = mk("TextButton", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -62, 0.5, 0), Size = UDim2.fromOffset(110, 26),
		BackgroundTransparency = 1, Text = "", ZIndex = 6 }, f)
	local track = mk("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.new(1, 0, 0, 4),
		BackgroundColor3 = th("SUB"), BackgroundTransparency = 0.6, BorderSizePixel = 0, ZIndex = 6 }, hit)
	corner(track, 2)
	local fill = mk("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = th("ACCENT"), BorderSizePixel = 0, ZIndex = 7 }, track)
	corner(fill, 2)
	local knob = mk("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(14, 14),
		BackgroundColor3 = th("ACCENT"), BorderSizePixel = 0, ZIndex = 8 }, track)
	corner(knob, 7)
	local value = default
	local function snap(v)
		v = math.clamp(v, min, max)
		return math.clamp(min + math.floor((v - min) / step + 0.5) * step, min, max)
	end
	value = snap(value)
	local function render()
		local fr = (value - min) / (max - min)
		fill.Size = UDim2.fromScale(fr, 1)
		knob.Position = UDim2.fromScale(fr, 0.5)
		vl.Text = tostring(math.floor(value + 0.5))
	end
	render()
	local dragging = false
	local function setFrom(input)
		local w = track.AbsoluteSize.X
		if w <= 0 then return end
		local v = snap(min + math.clamp((input.Position.X - track.AbsolutePosition.X) / w, 0, 1) * (max - min))
		if v ~= value then
			value = v
			render()
			if onChange then onChange(value) end
		end
	end
	hit.InputBegan:Connect(function(i)
		if isPress(i) then
			dragging = true
			page.scroll.ScrollingEnabled = false
			setFrom(i)
		end
	end)
	track.Parent.Parent = hit.Parent -- (tetap di dalam row)
	table.insert(conns, UserInputService.InputChanged:Connect(function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then setFrom(i) end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(i)
		if dragging and isPress(i) then
			dragging = false
			page.scroll.ScrollingEnabled = true
		end
	end))
	Ctl.sliders[name] = function() return value end
	return f
end

