-- ============================ LOGIKA =================================
-- =====================================================================
local function logic()
	local PenPanel
	task.spawn(function()
		local sap = ReplicatedStorage:WaitForChild("SAP", 10)
		local rem = sap and sap:WaitForChild("Remotes", 10)
		PenPanel = rem and rem:WaitForChild("PenPanel", 10)
		if not PenPanel then warn("[Senar Hub] PenPanel tidak ditemukan (Equip Best nonaktif)") end
	end)

	local autoPC, autoEquip, autoBubbles = false, false, false
	local skipped = setmetatable({}, { __mode = "k" })

	local function getRoot()
		local c = LocalPlayer.Character
		return c and c:FindFirstChild("HumanoidRootPart")
	end
	local function getHum()
		local c = LocalPlayer.Character
		return c and c:FindFirstChildOfClass("Humanoid")
	end
	local function getPos(obj)
		if obj:IsA("Model") then return obj:GetPivot().Position
		elseif obj:IsA("BasePart") then return obj.Position
		elseif obj:IsA("Attachment") then return obj.WorldPosition end
	end

	-- indeks prompt (supaya tidak scan seluruh workspace tiap 0.05 detik)
	local promptSet = {}
	for _, d in ipairs(workspace:GetDescendants()) do
		if d:IsA("ProximityPrompt") then promptSet[d] = true end
	end
	track(workspace.DescendantAdded:Connect(function(d)
		if d:IsA("ProximityPrompt") then promptSet[d] = true end
	end))
	track(workspace.DescendantRemoving:Connect(function(d)
		if d:IsA("ProximityPrompt") then promptSet[d] = nil end
	end))

	local function tpTo(pos)
		local root = getRoot()
		if not root then return false end
		root.CFrame = CFrame.new(pos)
		root.AssemblyLinearVelocity = Vector3.zero
		return true
	end
	local function goSafe() tpTo(SAFE_POSITION) end

	-- ---------- bounds / box (asli) ----------
	local function getBounds(obj)
		if obj:IsA("BasePart") then return obj.CFrame, obj.Size
		elseif obj:IsA("Model") then return obj:GetBoundingBox() end
		local minV, maxV
		for _, p in ipairs(obj:GetDescendants()) do
			if p:IsA("BasePart") then
				local cf, s = p.CFrame, p.Size
				local r, u, l = cf.RightVector, cf.UpVector, cf.LookVector
				local half = Vector3.new(
					math.abs(r.X) * s.X + math.abs(u.X) * s.Y + math.abs(l.X) * s.Z,
					math.abs(r.Y) * s.X + math.abs(u.Y) * s.Y + math.abs(l.Y) * s.Z,
					math.abs(r.Z) * s.X + math.abs(u.Z) * s.Y + math.abs(l.Z) * s.Z) / 2
				local lo, hi = cf.Position - half, cf.Position + half
				minV = minV and Vector3.new(math.min(minV.X, lo.X), math.min(minV.Y, lo.Y), math.min(minV.Z, lo.Z)) or lo
				maxV = maxV and Vector3.new(math.max(maxV.X, hi.X), math.max(maxV.Y, hi.Y), math.max(maxV.Z, hi.Z)) or hi
			end
		end
		if not minV then return nil end
		return CFrame.new((minV + maxV) / 2), maxV - minV
	end
	local function inZone(pos, cf, size)
		local rel = cf:PointToObjectSpace(pos)
		return math.abs(rel.X) <= size.X / 2 + ZONE_MARGIN
			and math.abs(rel.Y) <= size.Y / 2 + ZONE_MARGIN
			and math.abs(rel.Z) <= size.Z / 2 + ZONE_MARGIN
	end
	local function detectBoxes()
		local folder = getZonesFolder()
		local zone = folder and selectedZone and folder:FindFirstChild(selectedZone)
		local boxes = workspace:FindFirstChild("SAPBoxes")
		local root = getRoot()
		if not (zone and boxes and root) then return {} end
		local cf, size = getBounds(zone)
		if not cf then return {} end
		local list, now = {}, os.clock()
		for _, box in ipairs(boxes:GetChildren()) do
			if not (skipped[box] and now - skipped[box] < SKIP_TIME) then
				local pos = getPos(box)
				if pos and inZone(pos, cf, size) then
					table.insert(list, { box = box, dist = (pos - root.Position).Magnitude })
				end
			end
		end
		table.sort(list, function(a, b) return a.dist < b.dist end)
		return list
	end

	local function fireNearbyPrompts()
		local root = getRoot()
		if not (root and fireproximityprompt) then return 0 end
		local count = 0
		for d in pairs(promptSet) do
			if d.Parent and d.Enabled then
				local pp = getPos(d.Parent)
				if pp and (pp - root.Position).Magnitude <= PROMPT_RANGE then
					pcall(function() d.HoldDuration = 0 end)
					pcall(fireproximityprompt, d)
					count += 1
				end
			end
		end
		return count
	end
	local function findBoxPrompt(box) return box:FindFirstChildWhichIsA("ProximityPrompt", true) end

	-- ambil PC (logika asli, tanpa TP awal; ditambah batas waktu)
	local function grabBox(box, alive)
		local fired = false
		local t0 = os.clock()
		while alive() and box.Parent and os.clock() - t0 < 10 do
			fireNearbyPrompts()
			local p = findBoxPrompt(box)
			if p then
				fired = true
				if not p.Enabled then break end
			elseif fired then
				break
			end
			task.wait(FIRE_INTERVAL)
		end
		return fired
	end

	-- taruh PC / ambil lagi
	local function placePC()
		local hum, ch = getHum(), LocalPlayer.Character
		local holdingTool = ch and ch:FindFirstChildOfClass("Tool")
		if holdingTool and hum then
			pcall(function() hum:UnequipTools() end) -- PC dipegang sebagai Tool -> lepas
		else
			fireNearbyPrompts()                       -- PC dibawa lewat prompt -> tekan untuk menaruh
		end
		task.wait(PLACE_WAIT)
	end
	local function takePC(box)
		local p = box and box.Parent and findBoxPrompt(box)
		if p and p.Enabled and fireproximityprompt then
			pcall(function() p.HoldDuration = 0 end)
			pcall(fireproximityprompt, p)
		end
		fireNearbyPrompts()
		task.wait(PLACE_WAIT)
	end

	-- ---------- gerak paksa smooth ----------
	local moving = false
	track(RunService.Stepped:Connect(function()
		if not moving then return end
		local ch = LocalPlayer.Character
		if not ch then return end
		for _, p in ipairs(ch:GetDescendants()) do
			if p:IsA("BasePart") then p.CanCollide = false end
		end
	end))

	local function smoothMove(target, speed, done, alive)
		local root = getRoot()
		if not root then return false end
		moving = true
		local bv = Instance.new("BodyVelocity")
		bv.Name = "SenarHold"
		bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
		bv.Velocity = Vector3.zero
		bv.Parent = root
		local reached = false
		local t0 = os.clock()
		while alive() and os.clock() - t0 < 60 do
			root = getRoot()
			if not root then break end
			if done(root.Position) then reached = true break end
			local dt = RunService.Heartbeat:Wait()
			local delta = target - root.Position
			local dist = delta.Magnitude
			if dist < 0.5 then reached = true break end
			local ramp = math.min(1, 0.2 + (os.clock() - t0) / 0.4) -- awal pelan -> smooth
			local step = math.min(speed * ramp * dt, dist)
			root.CFrame = CFrame.new(root.Position + delta.Unit * step) * (root.CFrame - root.CFrame.Position)
			root.AssemblyLinearVelocity = Vector3.zero
		end
		pcall(function() bv:Destroy() end)
		moving = false
		return reached
	end

	local function walkTo(pos, alive)
		local t0 = os.clock()
		while alive() and os.clock() - t0 < 25 do
			local root, hum = getRoot(), getHum()
			if not (root and hum) then break end
			local flat = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z).Magnitude
			if flat < 5 and math.abs(pos.Y - root.Position.Y) < 12 then return true end
			hum:MoveTo(pos)
			task.wait(0.15)
		end
		return false
	end

	-- ---------- METHOD ----------
	-- 1) Quick Step: TP bertahap ke Safe Zone, tiap langkah taruh + ambil PC
	local function quickStep(box, alive)
		for _ = 1, 300 do
			if not alive() then return end
			local root = getRoot()
			if not root then return end
			local delta = SAFE_POSITION - root.Position
			local dist = delta.Magnitude
			if dist <= 6 then break end
			tpTo(root.Position + delta.Unit * math.min(P.QuickStep, dist))
			task.wait(0.1)
			placePC()
			takePC(box)
		end
		if alive() then goSafe() end
	end

	-- 2/3) Stealer (jalan ke PC) & Helt (TP ke PC)
	local function stealerFlow(box, viaTP, alive)
		local pos = getPos(box)
		if not pos then return false end
		if viaTP then
			tpTo(pos + Vector3.new(0, TELEPORT_HEIGHT, 0))
		elseif not walkTo(pos, alive) then
			tpTo(pos + Vector3.new(0, TELEPORT_HEIGHT, 0)) -- gagal jalan -> TP
		end
		if not alive() then return false end

		local fired = grabBox(box, alive)
		if not fired or not alive() then return fired end

		-- naik
		local root = getRoot()
		if not root then return fired end
		local airY = root.Position.Y + P.Climb
		tpTo(Vector3.new(root.Position.X, airY, root.Position.Z))

		-- force smooth ke atas Safe Zone, berhenti saat tinggal P.Descend dari Safe Zone
		local airTarget = Vector3.new(SAFE_POSITION.X, airY, SAFE_POSITION.Z)
		smoothMove(airTarget, P.Speed, function(p)
			return Vector3.new(p.X - airTarget.X, 0, p.Z - airTarget.Z).Magnitude <= P.Descend
		end, alive)
		if not alive() then return fired end

		-- turun dulu (sebelum Safe Zone)
		local r2 = getRoot()
		if r2 then
			local ground = Vector3.new(r2.Position.X, SAFE_POSITION.Y, r2.Position.Z)
			smoothMove(ground, 500, function(p) return (p - ground).Magnitude < 1 end, alive)
		end
		if not alive() then return fired end

		-- taruh PC, ambil lagi, lalu TP ke Safe Zone
		placePC()
		takePC(box)
		if alive() then goSafe() end
		return fired
	end

	local function processBox(box, alive)
		local m = selectedMethod
		if m == "Quick Step" then
			local pos = getPos(box)
			if pos then tpTo(pos + Vector3.new(0, TELEPORT_HEIGHT, 0)) end
			if grabBox(box, alive) then quickStep(box, alive) end
		elseif m == "Stealer" then
			stealerFlow(box, false, alive)
		elseif m == "Helt" or m == "Internet Explorer" then
			stealerFlow(box, true, alive)
		else -- Normal (asli)
			local pos = getPos(box)
			if pos then tpTo(pos + Vector3.new(0, TELEPORT_HEIGHT, 0)) end
			grabBox(box, alive)
		end
	end

	-- ---------- 4) Internet Explorer: klone karakter ----------
	local clone
	local function startClone()
		if clone then return end
		local ch = LocalPlayer.Character
		if not ch then return end
		ch.Archivable = true
		clone = ch:Clone()
		clone.Name = LocalPlayer.Name .. "_IE"
		for _, d in ipairs(clone:GetDescendants()) do
			if d:IsA("LuaSourceContainer") then
				d:Destroy()
			elseif d:IsA("BasePart") then
				d.CanCollide = false
				d.CanTouch = false
			end
		end
		local chrp = clone:FindFirstChild("HumanoidRootPart")
		if chrp then chrp.Anchored = true end
		clone.Parent = workspace
		local chum = clone:FindFirstChildOfClass("Humanoid")
		local cam = workspace.CurrentCamera
		if chum and cam then cam.CameraSubject = chum end
	end
	local function stopClone()
		if not clone then return end
		local hum, cam = getHum(), workspace.CurrentCamera
		if hum and cam then cam.CameraSubject = hum end
		clone:Destroy()
		clone = nil
	end
	track(RunService.RenderStepped:Connect(function()
		if clone then
			local chum = clone:FindFirstChildOfClass("Humanoid")
			local cam = workspace.CurrentCamera
			if chum and cam and cam.CameraSubject ~= chum then cam.CameraSubject = chum end
		end
	end))

	-- ---------- toggle ----------
	Ctl.handlers["Auto PC"] = function(enabled)
		autoPC = enabled
		if not enabled then
			stopClone()
			setStatus("Idle")
			return
		end
		if not fireproximityprompt then toast("Executor tidak support fireproximityprompt") end
		task.spawn(function()
			local function alive() return autoPC end
			while autoPC and gui.Parent do
				if selectedMethod == "Internet Explorer" then startClone() else stopClone() end
				local list = detectBoxes()
				if #list > 0 then
					setStatus(string.format("%s • %d PC • %s", tostring(selectedZone), #list, selectedMethod))
					for _, item in ipairs(list) do
						if not autoPC then break end
						if item.box.Parent then
							processBox(item.box, alive)
							skipped[item.box] = os.clock()
							if not autoPC then break end
							task.wait(RETURN_DELAY)
							goSafe()
							task.wait(RETURN_STAY)
						end
					end
				else
					setStatus(selectedZone and "Menunggu PC..." or "Pilih zona dulu")
					task.wait(1)
				end
			end
			stopClone()
			setStatus("Idle")
		end)
	end

	Ctl.handlers["Equip Best"] = function(enabled)
		autoEquip = enabled
		if not enabled then return end
		task.spawn(function()
			while autoEquip and gui.Parent do
				if PenPanel then
					pcall(function() return PenPanel:InvokeServer("equipBest") end)
				end
				task.wait(EQUIP_INTERVAL)
			end
		end)
	end

	local function pressButton(btn)
		pcall(function()
			if firesignal then
				firesignal(btn.MouseButton1Down)
				firesignal(btn.MouseButton1Click)
				firesignal(btn.Activated)
				firesignal(btn.MouseButton1Up)
			elseif getconnections then
				for _, c in ipairs(getconnections(btn.MouseButton1Click)) do c:Fire() end
				for _, c in ipairs(getconnections(btn.Activated)) do c:Fire() end
			end
		end)
	end
	local function findBubbles()
		local list = {}
		local pg = LocalPlayer:FindFirstChild("PlayerGui")
		if not pg then return list end
		for _, d in ipairs(pg:GetDescendants()) do
			if d.Name == "TrainingBubbles" then
				for _, b in ipairs(d:GetDescendants()) do
					if b.Name == "Bubble" and b:IsA("GuiButton") and b.Visible then table.insert(list, b) end
				end
			end
		end
		return list
	end
	Ctl.handlers["Auto Train Bubbles"] = function(enabled)
		autoBubbles = enabled
		if not enabled then return end
		task.spawn(function()
			while autoBubbles and gui.Parent do
				for _, b in ipairs(findBubbles()) do
					if not autoBubbles then break end
					pressButton(b)
				end
				task.wait(BUBBLE_INTERVAL)
			end
		end)
	end

	-- cleanup khusus logika
	env.__SenarPCStop = function()
		autoPC, autoEquip, autoBubbles = false, false, false
		stopClone()
	end
end

local okL, errL = pcall(logic)
if not okL then warn("[Senar Hub] logic error: " .. tostring(errL)) end

env.__SenarPCCleanup = function()
	if env.__SenarPCStop then pcall(env.__SenarPCStop) env.__SenarPCStop = nil end
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	if gui and gui.Parent then gui:Destroy() end
	env.__SenarPCCleanup = nil
end

