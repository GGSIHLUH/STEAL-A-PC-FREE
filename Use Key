function applyFilter(txt)
	txt = (txt or ""):lower()
	local pg = pages[currentPage]
	if not pg then return end
	local lastHead, headVisible = nil, false
	for _, it in ipairs(pg.items) do
		if it.kind == "head" then
			if lastHead then lastHead.Visible = headVisible or txt == "" end
			lastHead, headVisible = it.frame, false
		else
			local vis = txt == "" or it.text:find(txt, 1, true) ~= nil
			it.frame.Visible = vis
			if vis then headVisible = true end
		end
	end
	if lastHead then lastHead.Visible = headVisible or txt == "" end
end
